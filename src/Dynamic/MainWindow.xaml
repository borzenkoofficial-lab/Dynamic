<Window
    x:Class="Dynamic.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Dynamic">
    <Grid x:Name="Root" Background="Transparent">
        <Border
            x:Name="Capsule"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,12,0,0"
            Padding="18,10"
            Background="#F20B0D11"
            BorderBrush="#50FFFFFF"
            BorderThickness="1"
            CornerRadius="28">
            <StackPanel Orientation="Horizontal" Spacing="13">
                <Border
                    Width="38"
                    Height="38"
                    CornerRadius="13"
                    Background="#252B35"
                    VerticalAlignment="Center">
                    <TextBlock
                        Text="D"
                        Foreground="#F7F8FA"
                        FontSize="20"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock
                        Text="DYNAMIC"
                        Foreground="#F7F8FA"
                        FontSize="11"
                        FontWeight="SemiBold"
                        CharacterSpacing="150" />
                    <TextBlock
                        Text="Capsule foundation"
                        Foreground="#AEB5C0"
                        FontSize="12" />
                </StackPanel>
                <Ellipse
                    Width="7"
                    Height="7"
                    Fill="#B7F36B"
                    VerticalAlignment="Center"
                    Margin="12,0,2,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
<Window
    x:Class="Dynamic.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Dynamic">
    <Grid x:Name="Root" Background="Transparent">
        <Border
            x:Name="Capsule"
            Height="76"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            Padding="18,10"
            Background="#D90B0D11"
            BorderBrush="#70FFFFFF"
            BorderThickness="1"
            CornerRadius="38"
            RenderTransformOrigin="0.5,0.5">
            <Grid>
                <Border x:Name="GlassBase" IsHitTestVisible="False" CornerRadius="38"
                        BorderThickness="1" BorderBrush="#A6FFFFFF"
                        Background="#D90B0D11" />
                <Border x:Name="TopSheen" IsHitTestVisible="False" CornerRadius="38"
                        Margin="1" VerticalAlignment="Top" Height="34" Opacity="0.72">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#42FFFFFF" Offset="0" />
                            <GradientStop Color="#12FFFFFF" Offset="0.55" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Border x:Name="HighlightLayer" IsHitTestVisible="False" CornerRadius="38"
                        Opacity="0">
                    <Border.Background>
                        <RadialGradientBrush x:Name="PointerHighlight" Center="0.5,0.5"
                                             GradientOrigin="0.5,0.5" RadiusX="0.72" RadiusY="0.9">
                            <GradientStop Color="#55FFFFFF" Offset="0" />
                            <GradientStop Color="#18B7F36B" Offset="0.32" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>
                <Border x:Name="EdgeGlow" IsHitTestVisible="False" CornerRadius="38"
                        BorderThickness="1.4" Opacity="0.42">
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#BFFFFFFF" Offset="0" />
                            <GradientStop Color="#30B7F36B" Offset="0.48" />
                            <GradientStop Color="#70FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                </Border>
                <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="38" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="38" Height="38" CornerRadius="13" Background="#353B46" VerticalAlignment="Center">
                    <TextBlock Text="D" Foreground="#F7F8FA" FontSize="20" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="DYNAMIC" Foreground="#F7F8FA" FontSize="11" FontWeight="SemiBold" CharacterSpacing="150" />
                    <TextBlock x:Name="CapsuleSubtitle" Text="Рабочая капсула" Foreground="#C4CAD3" FontSize="12"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Ellipse Grid.Column="2" Width="7" Height="7" Fill="#B7F36B" VerticalAlignment="Center" Margin="12,0,2,0" />
                </Grid>
            </Grid>
        </Border>

        <Border x:Name="ExpandedPanel" Visibility="Collapsed" Margin="0,88,0,0" Padding="22"
                VerticalAlignment="Top" Background="#E6101217" BorderBrush="#75FFFFFF"
                BorderThickness="1" CornerRadius="28">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <StackPanel Spacing="16">
                <Grid>
                    <StackPanel Spacing="3">
                        <TextBlock Text="ЦЕНТР DYNAMIC" Foreground="#F7F8FA" FontSize="11" FontWeight="SemiBold" CharacterSpacing="130" />
                        <TextBlock Text="Системная панель" Foreground="#AEB6C2" FontSize="13" />
                    </StackPanel>
                    <Button x:Name="CollapseButton" Content="Свернуть" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Click="OnCollapseClick" Background="#26313B" Foreground="#F7F8FA" BorderThickness="0"
                            CornerRadius="14" Padding="14,7" />
                </Grid>

                <Border x:Name="MediaCard" Padding="16" Background="#252B34" CornerRadius="20"
                        BorderBrush="#28FFFFFF" BorderThickness="1">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="MediaArtwork" Width="48" Height="48" CornerRadius="13" Background="#3B414D"
                                BorderBrush="#55FFFFFF" BorderThickness="1">
                            <TextBlock Text="♫" Foreground="#B7F36B" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="СЕЙЧАС ИГРАЕТ" Foreground="#8F9AA8" FontSize="9" CharacterSpacing="100" />
                            <TextBlock x:Name="MediaTitle" Text="Медиа не обнаружено" Foreground="#F7F8FA" FontSize="14"
                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="MediaArtist" Text="Запустите музыку в поддерживаемом приложении"
                                       Foreground="#AEB6C2" FontSize="11" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                            <Button x:Name="PlayPauseButton" Content="▶" Click="OnPlayPauseClick"
                                    Background="#3B4652" Foreground="#F7F8FA" BorderThickness="0"
                                    CornerRadius="15" Width="38" Height="38" IsEnabled="False" />
                            <Button x:Name="NextButton" Content="»" Click="OnNextClick"
                                    Background="#3B4652" Foreground="#F7F8FA" BorderThickness="0"
                                    CornerRadius="15" Width="38" Height="38" IsEnabled="False" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Height="1" Background="#30FFFFFF" />
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="PlatformCard" Padding="14" Background="#252B34" CornerRadius="18" BorderBrush="#24FFFFFF" BorderThickness="1">
                        <StackPanel Spacing="5">
                            <TextBlock Text="ПЛАТФОРМА" Foreground="#8F9AA8" FontSize="9" CharacterSpacing="100" />
                            <TextBlock Text="Windows" Foreground="#F7F8FA" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="Нативное приложение" Foreground="#AEB6C2" FontSize="11" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="StatusCard" Grid.Column="1" Padding="14" Background="#252B34" CornerRadius="18" BorderBrush="#24FFFFFF" BorderThickness="1">
                        <StackPanel Spacing="5">
                            <TextBlock Text="СОСТОЯНИЕ" Foreground="#8F9AA8" FontSize="9" CharacterSpacing="100" />
                            <TextBlock Text="Активна" Foreground="#B7F36B" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="Локальный режим" Foreground="#AEB6C2" FontSize="11" />
                        </StackPanel>
                    </Border>
                </Grid>
                <TextBlock Text="Управление медиа получает данные напрямую из активной системной сессии Windows."
                           Foreground="#8F9AA8" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</Window>

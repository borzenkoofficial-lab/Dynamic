<Window
    x:Class="Dynamic.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Dynamic">
    <Grid x:Name="Root" Background="Transparent">
        <Border
            x:Name="Capsule"
            Height="76"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            Padding="18,10"
            Background="#D90B0D11"
            BorderBrush="#70FFFFFF"
            BorderThickness="1"
            CornerRadius="38"
            RenderTransformOrigin="0.5,0.5">
            <Grid>
                <Border x:Name="GlassBase" IsHitTestVisible="False" CornerRadius="38"
                        BorderThickness="1" BorderBrush="#A6FFFFFF"
                        Background="#D90B0D11" />
                <Border x:Name="TopSheen" IsHitTestVisible="False" CornerRadius="38"
                        Margin="1" VerticalAlignment="Top" Height="34" Opacity="0.72">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#42FFFFFF" Offset="0" />
                            <GradientStop Color="#12FFFFFF" Offset="0.55" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Border x:Name="HighlightLayer" IsHitTestVisible="False" CornerRadius="38"
                        Opacity="0">
                    <Border.Background>
                        <RadialGradientBrush x:Name="PointerHighlight" Center="0.5,0.5"
                                             GradientOrigin="0.5,0.5" RadiusX="0.72" RadiusY="0.9">
                            <GradientStop Color="#55FFFFFF" Offset="0" />
                            <GradientStop Color="#18B7F36B" Offset="0.32" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>
                <Border x:Name="EdgeGlow" IsHitTestVisible="False" CornerRadius="38"
                        BorderThickness="1.4" Opacity="0.42">
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#BFFFFFFF" Offset="0" />
                            <GradientStop Color="#30B7F36B" Offset="0.48" />
                            <GradientStop Color="#70FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                </Border>
                <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="38" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="38" Height="38" CornerRadius="13" Background="#353B46" VerticalAlignment="Center">
                    <TextBlock Text="D" Foreground="#F7F8FA" FontSize="20" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="DYNAMIC" Foreground="#F7F8FA" FontSize="11" FontWeight="SemiBold" CharacterSpacing="150" />
                    <TextBlock x:Name="CapsuleSubtitle" Text="Рабочая капсула" Foreground="#C4CAD3" FontSize="12"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Ellipse Grid.Column="2" Width="7" Height="7" Fill="#B7F36B" VerticalAlignment="Center" Margin="12,0,2,0" />
                </Grid>
            </Grid>
        </Border>

        <Border x:Name="ExpandedPanel" Visibility="Collapsed" Margin="0,88,0,0" Padding="22"
                VerticalAlignment="Top" Background="#E6101217" BorderBrush="#75FFFFFF"
                BorderThickness="1" CornerRadius="28">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="570">
            <StackPanel Spacing="14">
                <Grid>
                    <StackPanel Spacing="3">
                        <TextBlock Text="ЦЕНТР DYNAMIC" Foreground="#F7F8FA" FontSize="11" FontWeight="SemiBold" CharacterSpacing="130" />
                        <TextBlock Text="Системная панель" Foreground="#AEB6C2" FontSize="13" />
                    </StackPanel>
                    <Button x:Name="CollapseButton" Content="Свернуть" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Click="OnCollapseClick" Background="#26313B" Foreground="#F7F8FA" BorderThickness="0"
                            CornerRadius="14" Padding="14,7" />
                </Grid>

                <Border x:Name="MediaCard" Padding="15" Background="#252B34" CornerRadius="20"
                        BorderBrush="#35FFFFFF" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="54" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="MediaArtwork" Width="54" Height="54" CornerRadius="14"
                                    Background="#3B414D" BorderBrush="#55FFFFFF" BorderThickness="1">
                                <Grid>
                                    <TextBlock x:Name="MediaArtworkGlyph" Text="♫" Foreground="#B7F36B"
                                               FontSize="27" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Image x:Name="MediaArtworkImage" Stretch="UniformToFill" Visibility="Collapsed" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="СЕЙЧАС ИГРАЕТ" Foreground="#8F9AA8" FontSize="9" CharacterSpacing="100" />
                                <TextBlock x:Name="MediaTitle" Text="Медиа не обнаружено" Foreground="#F7F8FA"
                                           FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="MediaArtist" Text="Запустите музыку в поддерживаемом приложении"
                                           Foreground="#AEB6C2" FontSize="11" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                                <Button x:Name="PlayPauseButton" Content="▶" Click="OnPlayPauseClick"
                                        Background="#3B4652" Foreground="#F7F8FA" BorderThickness="0"
                                        CornerRadius="15" Width="38" Height="38" IsEnabled="False" />
                                <Button x:Name="NextButton" Content="»" Click="OnNextClick"
                                        Background="#3B4652" Foreground="#F7F8FA" BorderThickness="0"
                                        CornerRadius="15" Width="38" Height="38" IsEnabled="False" />
                            </StackPanel>
                        </Grid>
                        <ProgressBar x:Name="MediaProgress" Minimum="0" Maximum="1" Value="0"
                                     Height="3" Background="#45505D" Foreground="#B7F36B" />
                        <Grid>
                            <TextBlock x:Name="MediaElapsedText" Text="0:00" Foreground="#8F9AA8" FontSize="10" />
                            <TextBlock x:Name="MediaDurationText" Text="--:--" Foreground="#8F9AA8"
                                       FontSize="10" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>
                </Border>
                <Border x:Name="TimerCard" Padding="15" Background="#252B34" CornerRadius="20"
                        BorderBrush="#35FFFFFF" BorderThickness="1">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="58" Height="58">
                            <Ellipse Stroke="#46515E" StrokeThickness="4" />
                            <Path x:Name="TimerRingProgress" Stroke="#B7F36B" StrokeThickness="4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <TextBlock x:Name="TimerRingLabel" Text="05:00" Foreground="#F7F8FA"
                                       FontSize="10" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="ТАЙМЕР" Foreground="#8F9AA8" FontSize="9" CharacterSpacing="100" />
                            <TextBlock x:Name="TimerStatusText" Text="Готов к запуску" Foreground="#F7F8FA"
                                       FontSize="14" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Button Content="5 мин" Click="OnTimerPreset5Click" Padding="7,3"
                                        Background="#35404B" Foreground="#C4CAD3" BorderThickness="0" CornerRadius="8" FontSize="10" />
                                <Button Content="15 мин" Click="OnTimerPreset15Click" Padding="7,3"
                                        Background="#35404B" Foreground="#C4CAD3" BorderThickness="0" CornerRadius="8" FontSize="10" />
                                <Button Content="25 мин" Click="OnTimerPreset25Click" Padding="7,3"
                                        Background="#35404B" Foreground="#C4CAD3" BorderThickness="0" CornerRadius="8" FontSize="10" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="5">
                            <Button x:Name="TimerStartButton" Content="Старт" Click="OnTimerStartClick"
                                    Background="#B7F36B" Foreground="#151A16" BorderThickness="0"
                                    CornerRadius="12" Padding="11,8" />
                            <Button x:Name="TimerResetButton" Content="↺" Click="OnTimerResetClick"
                                    Background="#3B4652" Foreground="#F7F8FA" BorderThickness="0"
                                    CornerRadius="12" Width="34" Height="34" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border x:Name="ProgressCard" Padding="15" Background="#252B34" CornerRadius="20"
                        BorderBrush="#35FFFFFF" BorderThickness="1" Visibility="Collapsed">
                    <StackPanel Spacing="8">
                        <Grid>
                            <TextBlock x:Name="ActivityTitle" Text="ВЫПОЛНЯЕТСЯ" Foreground="#8F9AA8"
                                       FontSize="9" CharacterSpacing="100" />
                            <TextBlock x:Name="ActivityPercent" Text="0%" Foreground="#F7F8FA"
                                       FontSize="12" HorizontalAlignment="Right" />
                        </Grid>
                        <ProgressBar x:Name="ActivityProgress" Minimum="0" Maximum="100" Value="0"
                                     Height="5" Background="#45505D" Foreground="#B7F36B" />
                        <Grid>
                            <TextBlock x:Name="ActivityDetail" Text="" Foreground="#AEB6C2" FontSize="10" />
                            <TextBlock x:Name="ActivitySpeed" Text="" Foreground="#AEB6C2" FontSize="10"
                                       HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Height="1" Background="#30FFFFFF" />
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="PlatformCard" Padding="14" Background="#252B34" CornerRadius="18" BorderBrush="#24FFFFFF" BorderThickness="1">
                        <StackPanel Spacing="5">
                            <TextBlock Text="ПЛАТФОРМА" Foreground="#8F9AA8" FontSize="9" CharacterSpacing="100" />
                            <TextBlock Text="Windows" Foreground="#F7F8FA" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="Нативное приложение" Foreground="#AEB6C2" FontSize="11" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="StatusCard" Grid.Column="1" Padding="14" Background="#252B34" CornerRadius="18" BorderBrush="#24FFFFFF" BorderThickness="1">
                        <StackPanel Spacing="5">
                            <TextBlock Text="СОСТОЯНИЕ" Foreground="#8F9AA8" FontSize="9" CharacterSpacing="100" />
                            <TextBlock Text="Активна" Foreground="#B7F36B" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="Локальный режим" Foreground="#AEB6C2" FontSize="11" />
                        </StackPanel>
                    </Border>
                </Grid>
                <TextBlock Text="Системные данные отображаются только при наличии доступного источника."
                           Foreground="#8F9AA8" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
            </ScrollViewer>
        </Border>
        <Border x:Name="NotificationToast" Visibility="Collapsed" Opacity="0"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,96,0,0"
                Padding="15,12" Width="340" Background="#F020252D"
                BorderBrush="#80FFFFFF" BorderThickness="1" CornerRadius="18">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="◉" Foreground="#B7F36B" FontSize="18"
                           VerticalAlignment="Center" HorizontalAlignment="Center" />
                <StackPanel Grid.Column="1" Spacing="3">
                    <TextBlock x:Name="NotificationTitle" Text="Dynamic" Foreground="#F7F8FA"
                               FontSize="12" FontWeight="SemiBold" />
                    <TextBlock x:Name="NotificationMessage" Text="" Foreground="#C4CAD3"
                               FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
